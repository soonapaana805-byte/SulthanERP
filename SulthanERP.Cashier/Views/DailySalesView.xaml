<UserControl x:Class="SulthanERP.Cashier.Views.DailySalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="#0F172A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="24,0" VerticalAlignment="Center">
                <TextBlock Text="DAILY SALES SUMMARY" Foreground="White" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Read-only cashier collection summary" Foreground="#BFDBFE" FontSize="11" />
            </StackPanel>
            <Button Grid.Column="1" Content="Back to POS" Command="{Binding BackToPosCommand}" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Cash closing" Command="{Binding ShowCashClosingCommand}" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="Refresh" Command="{Binding LoadCommand}" Width="92" Height="34" Margin="0,0,20,0" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="Report date" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                    <DatePicker SelectedDate="{Binding SelectedDate}" Width="150" />
                    <Button Content="Load" Command="{Binding LoadCommand}" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" Margin="0,0,0,18" TextWrapping="Wrap" />

                <UniformGrid Columns="3" Margin="0,0,0,14">
                    <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,12,12">
                        <StackPanel><TextBlock Text="PAID BILLS" Foreground="#64748B" FontSize="11" /><TextBlock Text="{Binding Report.TotalBills}" FontSize="28" FontWeight="Bold" /></StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,12,12">
                        <StackPanel><TextBlock Text="GROSS SALES" Foreground="#64748B" FontSize="11" /><TextBlock FontSize="28" FontWeight="Bold"><Run Text="&#x20B9; " /><Run Text="{Binding Report.TotalSales, Mode=OneWay, StringFormat={}{0:N2}}" /></TextBlock></StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel><TextBlock Text="NET COLLECTION" Foreground="#64748B" FontSize="11" /><TextBlock FontSize="28" FontWeight="Bold"><Run Text="&#x20B9; " /><Run Text="{Binding Report.NetSales, Mode=OneWay, StringFormat={}{0:N2}}" /></TextBlock></StackPanel>
                    </Border>
                    <Border Background="#ECFDF5" CornerRadius="10" Padding="16" Margin="0,0,12,12">
                        <StackPanel><TextBlock Text="CASH" Foreground="#166534" FontSize="11" /><TextBlock FontSize="25" FontWeight="Bold"><Run Text="&#x20B9; " /><Run Text="{Binding Report.CashCollection, Mode=OneWay, StringFormat={}{0:N2}}" /></TextBlock></StackPanel>
                    </Border>
                    <Border Background="#EFF6FF" CornerRadius="10" Padding="16" Margin="0,0,12,12">
                        <StackPanel><TextBlock Text="CARD" Foreground="#1D4ED8" FontSize="11" /><TextBlock FontSize="25" FontWeight="Bold"><Run Text="&#x20B9; " /><Run Text="{Binding Report.CardCollection, Mode=OneWay, StringFormat={}{0:N2}}" /></TextBlock></StackPanel>
                    </Border>
                    <Border Background="#F5F3FF" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel><TextBlock Text="UPI" Foreground="#6D28D9" FontSize="11" /><TextBlock FontSize="25" FontWeight="Bold"><Run Text="&#x20B9; " /><Run Text="{Binding Report.UpiCollection, Mode=OneWay, StringFormat={}{0:N2}}" /></TextBlock></StackPanel>
                    </Border>
                    <Border Background="#FFF7ED" CornerRadius="10" Padding="16" Margin="0,0,12,12">
                        <StackPanel><TextBlock Text="CANCELLED UNPAID BILLS" Foreground="#9A3412" FontSize="11" /><TextBlock Text="{Binding Report.CancelledBills}" FontSize="25" FontWeight="Bold" /></StackPanel>
                    </Border>
                    <Border Background="#FEF2F2" CornerRadius="10" Padding="16" Margin="0,0,12,12">
                        <StackPanel><TextBlock Text="VOIDED PAID BILLS" Foreground="#991B1B" FontSize="11" /><TextBlock Text="{Binding Report.VoidedBills}" FontSize="25" FontWeight="Bold" /></StackPanel>
                    </Border>
                    <Border Background="#FEF2F2" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel><TextBlock Text="VOIDED AMOUNT" Foreground="#991B1B" FontSize="11" /><TextBlock FontSize="25" FontWeight="Bold"><Run Text="&#x20B9; " /><Run Text="{Binding Report.VoidedAmount, Mode=OneWay, StringFormat={}{0:N2}}" /></TextBlock></StackPanel>
                    </Border>
                </UniformGrid>

                <Border Background="White" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SALES BREAKDOWN" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
                            <TextBlock><Run Text="Gross sales: " /><Run Text="{Binding Report.TotalSales, Mode=OneWay, StringFormat={}{0:C}}" /></TextBlock>
                            <TextBlock><Run Text="Discount: " /><Run Text="{Binding Report.TotalDiscount, Mode=OneWay, StringFormat={}{0:C}}" /></TextBlock>
                            <TextBlock><Run Text="Tax: " /><Run Text="{Binding Report.TotalTax, Mode=OneWay, StringFormat={}{0:C}}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="OPEN PHONE BILLS (NOW)" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
                            <TextBlock><Run Text="Bills waiting for payment: " /><Run Text="{Binding PendingPhoneBillCount, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                            <TextBlock><Run Text="Outstanding amount: " /><Run Text="{Binding PendingPhoneAmount, Mode=OneWay, StringFormat={}{0:C}}" FontWeight="Bold" /></TextBlock>
                            <TextBlock Text="Use Kitchen bills to collect a pending payment." Foreground="#64748B" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
