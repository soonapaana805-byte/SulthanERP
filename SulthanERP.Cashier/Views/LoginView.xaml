<UserControl x:Class="SulthanERP.Cashier.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#172554">

        <Border Width="400"
                Padding="36"
                Background="White"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Sulthan ERP"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1D4ED8"/>

                <TextBlock Text="Cashier sign in"
                           Margin="0,4,0,28"
                           Foreground="#64748B"/>

                <TextBlock Text="Username"/>

                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SubmitLogin"
                         Margin="0,6,0,16"
                         Height="36"
                         IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Password"/>

                <Grid Margin="0,6,0,12">

                    <PasswordBox x:Name="PasswordInput"
                                 PasswordChanged="PasswordChanged"
                                 KeyDown="SubmitLogin"
                                 Height="36"
                                 Padding="8,0,72,0"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                                 VerticalContentAlignment="Center"/>

                    <TextBox x:Name="VisiblePasswordInput"
                             TextChanged="VisiblePasswordChanged"
                             KeyDown="SubmitLogin"
                             Visibility="Collapsed"
                             Height="36"
                             Padding="8,0,72,0"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                             VerticalContentAlignment="Center"/>

                    <Button x:Name="PasswordToggle"
                            Content="Show"
                            Click="TogglePassword"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Padding="8,3"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>

                </Grid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#B91C1C"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Grid>

                    <Button Content="Sign in"
                            Command="{Binding LoginCommand}"
                            Height="42"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <ProgressBar Width="80"
                                     Height="4"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Text="Signing in..."
                                   Margin="10,0,0,0"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    </StackPanel>

                </Grid>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>