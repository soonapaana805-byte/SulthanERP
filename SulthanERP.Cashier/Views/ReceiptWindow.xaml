<Window x:Class="SulthanERP.Cashier.Views.ReceiptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Receipt" Width="390" Height="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="White" Padding="24" CornerRadius="10"><StackPanel><TextBlock Text="Sulthan ERP" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Payment receipt" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,24"/><TextBlock Text="{Binding BillLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding OrderLabel}" Margin="0,6,0,0"/><Separator Margin="0,18,0,14"/><TextBlock Text="TOTAL PAID" FontSize="11" Foreground="#64748B"/><TextBlock Text="{Binding TotalLabel}" FontSize="28" FontWeight="Bold" Foreground="#15803D"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,18,0,0"/></StackPanel></Border><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Print" Click="PrintClick" Padding="16,7" Margin="0,0,8,0"/><Button Content="Close / New sale" Click="CloseClick" Padding="16,7" Background="#16A34A" Foreground="White"/></StackPanel></Grid>
</Window>
