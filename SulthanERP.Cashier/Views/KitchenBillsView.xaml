<UserControl x:Class="SulthanERP.Cashier.Views.KitchenBillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="#0F172A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="24,0" VerticalAlignment="Center">
                <TextBlock Text="KITCHEN BILLS" Foreground="White" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Select a bill to view its details" Foreground="#BFDBFE" FontSize="11" />
            </StackPanel>
            <Button Grid.Column="1" Content="Back to POS" Command="{Binding BackToPosCommand}" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Refresh" Command="{Binding LoadCommand}" Width="92" Height="34" Margin="0,0,20,0" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Bills}"
                              SelectedItem="{Binding SelectedBill}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KOT" Binding="{Binding ShortKotNumber}" Width="88">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="ToolTip" Value="{Binding KotNumber}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Bill" Binding="{Binding ShortBillNumber}" Width="82">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="ToolTip" Value="{Binding BillNumber}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mode" Binding="{Binding OrderType}" Width="78" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82" />
                            <DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat={}{0:N2}}" Width="88" />
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedOn, StringFormat={}{0:dd MMM HH:mm}}" Width="118" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="BILL DETAILS" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding DetailStatusMessage}" Foreground="#64748B" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Row="1"
                                   HorizontalAlignment="Right"
                                   Margin="0,10,0,0">
                            <Button Content="Collect pending payment"
                                    Command="{Binding CollectPendingPaymentCommand}"
                                    IsEnabled="{Binding CanCollectSelectedPendingOrder}"
                                    Visibility="{Binding CanCollectSelectedPendingOrder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="#16A34A"
                                    Foreground="White"
                                    Margin="0,0,8,8" />
                            <Button Content="Cancel selected KOT"
                                    Command="{Binding CancelSelectedKotCommand}"
                                    IsEnabled="{Binding CanCancelSelectedKot}"
                                    Background="#EA580C"
                                    Foreground="White"
                                    Margin="0,0,8,8" />
                            <Button Content="Cancel entire bill"
                                    Command="{Binding CancelEntireBillCommand}"
                                    IsEnabled="{Binding CanCancelSelectedBill}"
                                    Background="#DC2626"
                                    Foreground="White"
                                    Margin="0,0,8,8" />
                            <Button Content="Void paid bill"
                                    Command="{Binding VoidSelectedBillCommand}"
                                    IsEnabled="{Binding CanVoidSelectedBill}"
                                    Background="#991B1B"
                                    Foreground="White"
                                    Margin="0,0,8,8" />
                            <Button Content="Reprint"
                                    Command="{Binding ReprintSelectedBillCommand}"
                                    IsEnabled="{Binding CanReprintSelectedBill}"
                                    Margin="0,0,0,8" />
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,12,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BILL NO." Foreground="#64748B" FontSize="10" />
                                <TextBlock Text="{Binding SelectedBillDetail.BillNumber, TargetNullValue=—}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="KOT NO." Foreground="#64748B" FontSize="10" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding SelectedBillDetail.KotNumber, TargetNullValue=—}" FontSize="11" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding SelectedBillDetail.CustomerName, TargetNullValue=Walk-in customer}" Foreground="#475569" FontSize="11" Margin="0,8,0,0" />
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding SelectedBillDetail.Status}" Foreground="#B45309" FontWeight="SemiBold" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding SelectedBillDetail.PaymentMethod}" Foreground="#475569" />
                                <TextBlock Text="{Binding SelectedBillDetail.OrderType}" Foreground="#475569" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ITEMS" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" FontWeight="Bold">
                            <Run Text="&#x20B9; " />
                            <Run Text="{Binding SelectedBillDetail.GrandTotal, Mode=OneWay, StringFormat={}{0:N2}}" />
                        </TextBlock>
                    </Grid>

                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding SelectedBillDetail.Items}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="82" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
