<Window x:Class="SulthanERP.Cashier.Views.BillActionApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin approval"
        Width="430"
        Height="415"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="Bold" />
        <TextBlock Grid.Row="1" x:Name="BillSummaryText"
                   Foreground="#475569" Margin="0,4,0,14" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Admin username" FontWeight="SemiBold" />
                <TextBox x:Name="ManagerUserNameInput" Height="34" Margin="0,4,0,0"
                         VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Admin password" FontWeight="SemiBold" />
                <PasswordBox x:Name="ManagerPasswordInput" Height="34" Margin="0,4,0,0"
                             VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="Reason (mandatory)" FontWeight="SemiBold"
                   Margin="0,12,0,0" />
        <TextBox Grid.Row="4" x:Name="ReasonInput" Height="72" Margin="0,4,0,0"
                 AcceptsReturn="True" TextWrapping="Wrap" MaxLength="250" />
        <TextBlock Grid.Row="5" Text="This action cannot be reversed from the Cashier app."
                   Foreground="#B45309" FontSize="11" Margin="0,10,0,0" />
        <TextBlock Grid.Row="6" x:Name="ValidationMessage" Foreground="#B91C1C"
                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Back" IsCancel="True" MinWidth="90" Padding="12,7"
                    Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" IsDefault="True" MinWidth="130" Padding="12,7"
                    Background="#B91C1C" Foreground="White" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
