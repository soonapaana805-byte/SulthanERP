<UserControl x:Class="SulthanERP.Cashier.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="V" />
    </UserControl.Resources>

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="55" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="#0F172A">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="24,0">
                <TextBlock Text="SULTHAN ERP | Cashier POS"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#BFDBFE"
                           FontSize="10"
                           Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding CurrentBillDisplay}"
                       Foreground="#BFDBFE"
                       VerticalAlignment="Center"
                       Margin="0,0,18,0" />
            <TextBlock Grid.Column="2"
                       Text="{Binding OrderMode}"
                       Foreground="#BFDBFE"
                       VerticalAlignment="Center"
                       Margin="0,0,18,0" />
            <Button Grid.Column="3"
                    Content="Kitchen bills"
                    Click="KitchenBills_Click"
                    Height="34"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center" />
            <Button Grid.Column="4"
                    Content="Day summary"
                    Click="DaySummary_Click"
                    Height="34"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center" />
            <Button Grid.Column="5"
                    Content="Refresh"
                    Click="RefreshMenu_Click"
                    Width="92"
                    Height="34"
                    Margin="0,0,20,0"
                    VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="18,9">
            <Button Content="Table Book" Command="{Binding SetOrderModeCommand}" CommandParameter="Table Book" Margin="0,0,8,0" />
            <Button Content="Take Away" Command="{Binding SetOrderModeCommand}" CommandParameter="Take Away" Margin="0,0,8,0" />
            <Button Content="Home Delivery" Command="{Binding SetOrderModeCommand}" CommandParameter="Home Delivery" Margin="0,0,8,0" />
            <Button Content="Phone Order" Command="{Binding SetOrderModeCommand}" CommandParameter="Phone Order" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="165" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,12,0"
                    IsEnabled="{Binding IsMenuEditable}"
                    Visibility="{Binding IsMenuSelectionVisible, Converter={StaticResource V}}">
                <StackPanel>
                    <TextBlock Text="CATEGORIES" FontWeight="Bold" />
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             DisplayMemberPath="Name"
                             Margin="0,10,0,0"
                             BorderThickness="0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,12,0"
                    IsEnabled="{Binding IsMenuEditable}"
                    Visibility="{Binding IsMenuSelectionVisible, Converter={StaticResource V}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="MENU ITEMS" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Tap an item to add it to the bill" Foreground="#64748B" FontSize="11" />
                    </StackPanel>
                    <TextBox Grid.Row="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,10,0,10"
                             VerticalContentAlignment="Center"
                             ToolTip="Search menu" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredMenuItems}" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Width="174" Height="110" Margin="0,0,10,10"
                                        Command="{Binding DataContext.AddMenuItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                                        <TextBlock Foreground="#15803D" FontWeight="Bold" Margin="0,8,0,0">
                                            <Run Text="&#x20B9; " />
                                            <Run Text="{Binding DisplayPrice, Mode=OneWay, StringFormat={}{0:N2}}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,12,0"
                    Visibility="{Binding IsTableSelectionVisible, Converter={StaticResource V}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="TABLE BOOK" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Green: available  |  Blue: occupied  |  Red: bill requested  |  Orange: payment pending  |  Purple: cleaning"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Content="Refresh tables"
                                Command="{Binding LoadDiningTablesCommand}"
                                DockPanel.Dock="Right"
                                Padding="12,6" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding DiningTables}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="132" Margin="0,0,12,12">
                                    <Button Height="104"
                                            Margin="0"
                                            Command="{Binding DataContext.SelectDiningTableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#16A34A" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="Padding" Value="8" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid x:Name="CardRoot"
                                                                  RenderTransformOrigin="0.5,0.5">
                                                                <Grid.RenderTransform>
                                                                    <TransformGroup>
                                                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                                                        <TranslateTransform Y="0" />
                                                                    </TransformGroup>
                                                                </Grid.RenderTransform>
                                                                <Border x:Name="ShadowSurface"
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="8" />
                                                                <Border x:Name="CardSurface"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="8"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                                </Border>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CardSurface"
                                                                            Property="BorderBrush"
                                                                            Value="#F8FAFC" />
                                                                    <Setter TargetName="ShadowSurface" Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect Color="#0F172A"
                                                                                              BlurRadius="15"
                                                                                              ShadowDepth="4"
                                                                                              Opacity="0.38" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter TargetName="CardRoot" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <TransformGroup>
                                                                                <ScaleTransform ScaleX="1.035" ScaleY="1.035" />
                                                                                <TranslateTransform Y="-2" />
                                                                            </TransformGroup>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="CardRoot" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <TransformGroup>
                                                                                <ScaleTransform ScaleX="0.99" ScaleY="0.99" />
                                                                                <TranslateTransform Y="0" />
                                                                            </TransformGroup>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="CardRoot" Property="Opacity" Value="0.55" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Panel.ZIndex" Value="10" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Background" Value="#DC2626" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                                        <Setter Property="Background" Value="#2563EB" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBillRequested}" Value="True">
                                                        <Setter Property="Background" Value="#DC2626" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPaymentPending}" Value="True">
                                                        <Setter Property="Background" Value="#F59E0B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCleaningPending}" Value="True">
                                                        <Setter Property="Background" Value="#7C3AED" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TableNumber}"
                                                       FontSize="21"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding TableType}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Visibility="{Binding IsMenuSelectionVisible, Converter={StaticResource V}}">
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="BILLING"
               FontSize="18"
               FontWeight="Bold"
               VerticalAlignment="Center" />

                            <Border Grid.Column="1"
            Background="#DBEAFE"
            BorderBrush="#2563EB"
            BorderThickness="1"
            CornerRadius="7"
            Padding="12,5"
            HorizontalAlignment="Right">

                                <TextBlock Text="{Binding OrderMode}"
                   Foreground="#1D4ED8"
                   FontSize="13"
                   FontWeight="Bold" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding CurrentBillDisplay}" Foreground="#64748B" FontSize="11" Margin="0,1,0,7" />
                        <TextBlock Text="Customer name (optional)" FontSize="11" Foreground="#475569" />
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsPendingPhoneOrder}"
                                 Height="28"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Optional customer name" />
                        <TextBlock Text="Pending bill -- items are locked; collect payment to close this bill."
                                   Foreground="#B45309"
                                   FontSize="11"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsPendingPhoneOrder, Converter={StaticResource V}}" />
                        <Button Content="Back to pending bills"
                                Command="{Binding ShowKitchenBillsCommand}"
                                HorizontalAlignment="Left"
                                Padding="10,5"
                                Margin="0,7,0,0"
                                Visibility="{Binding IsPendingPhoneOrder, Converter={StaticResource V}}" />
                    </StackPanel>

                    <DataGrid x:Name="CartGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Cart}"
                              SelectedItem="{Binding SelectedCartLine}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              IsEnabled="{Binding IsMenuEditable}"
                              LoadingRow="CartGrid_LoadingRow"
                              Margin="0,12,0,8"
                              Visibility="{Binding IsMenuSelectionVisible, Converter={StaticResource V}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
                            <DataGridTemplateColumn Header="Qty" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="-" Width="34" Height="32" Background="#E2E8F0"
                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding Quantity}" Width="32" TextAlignment="Center" VerticalAlignment="Center" />
                                            <Button Content="+" Width="34" Height="32" Background="#2563EB" Foreground="White"
                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Total" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextAlignment="Right">
                                            <Run Text="&#x20B9; " />
                                            <Run Text="{Binding LineTotal, Mode=OneWay, StringFormat={}{0:N2}}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2"
                                Visibility="{Binding IsMenuSelectionVisible, Converter={StaticResource V}}">
                        <Border Background="#FEF2F2"
                                BorderBrush="#FCA5A5"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                Margin="0,0,0,8"
                                MaxHeight="64"
                                ClipToBounds="True"
                                Visibility="{Binding HasPaymentError, Converter={StaticResource V}}">
                            <TextBlock Text="{Binding PaymentErrorMessage}"
                                       Foreground="#B91C1C"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxHeight="46"
                                       ClipToBounds="True" />
                        </Border>
                        <Button Content="Remove selected item"
                                Command="{Binding RemoveSelectedLineCommand}"
                                IsEnabled="{Binding IsMenuEditable}"
                                HorizontalAlignment="Left" />

                        <Border Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="#475569">
                                        <Run Text="Subtotal: " />
                                        <Run Text="{Binding SubTotalDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Foreground="#B45309" Margin="0,3,0,0">
                                        <Run Text="Discount: " />
                                        <Run Text="{Binding DiscountDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding DiscountButtonText}"
                                        Command="{Binding ApplyDiscountCommand}"
                                        IsEnabled="{Binding CanApplyDiscount}"
                                        Background="#D97706"
                                        Foreground="White"
                                        Padding="10,6"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ComboBox SelectedValue="{Binding PaymentMethod}" SelectedValuePath="Content" Height="30" Margin="0,8,0,0">
                            <ComboBoxItem Content="Cash" />
                            <ComboBoxItem Content="Card" />
                            <ComboBoxItem Content="UPI" />
                        </ComboBox>
                        <StackPanel Visibility="{Binding IsSingleCashPayment, Converter={StaticResource V}}">
                            <TextBlock Text="Tendered amount" Margin="0,8,0,2" />
                            <TextBox Text="{Binding TenderedAmount, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                            <TextBlock Text="{Binding ChangeAmount, StringFormat=Change: {0:C}}" Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox Content="Split payment" IsChecked="{Binding IsSplitPayment}" Margin="0,8,0,0" />
                        <StackPanel Visibility="{Binding IsSplitPayment, Converter={StaticResource V}}">
                            <TextBlock Text="First payment amount" />
                            <TextBox Text="{Binding SplitAmount, UpdateSourceTrigger=PropertyChanged}" Height="30" />
                            <TextBlock Text="Second payment method" Margin="0,5,0,2" />
                            <ComboBox SelectedValue="{Binding SecondPaymentMethod}" SelectedValuePath="Content" Height="30">
                                <ComboBoxItem Content="Cash" />
                                <ComboBoxItem Content="Card" />
                                <ComboBoxItem Content="UPI" />
                            </ComboBox>
                            <TextBlock>
                                <Run Text="Balance: &#x20B9; " />
                                <Run Text="{Binding SplitBalance, Mode=OneWay, StringFormat={}{0:N2}}" />
                            </TextBlock>
                        </StackPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="{Binding TotalDisplay}" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Send KOT (payment later)"
                                        Command="{Binding SendPhoneOrderToKitchenCommand}"
                                        Background="#D97706"
                                        Foreground="White"
                                        Padding="10,7"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding CanSendPhoneOrderToKitchen, Converter={StaticResource V}}" />
                                <Button Content="{Binding CompletePaymentText}"
                                        Command="{Binding CheckoutCommand}"
                                        Background="#16A34A"
                                        Foreground="White"
                                        Padding="14,7" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <Grid Grid.RowSpan="3"
                          Visibility="{Binding IsTableBook, Converter={StaticResource V}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="TABLE DETAILS" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding SelectedDiningTable.DisplayName, TargetNullValue='Select a table'}"
                                       Foreground="#475569"
                                       FontSize="12"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="{Binding SelectedDiningTable.StatusDisplay, TargetNullValue=''}"
                                       Foreground="#0F766E"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,14,0,8"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Captain" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding SelectedTablePendingOrder.CaptainName, TargetNullValue='—'}"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0" />

                                <TextBlock Text="Bill / KOT" FontSize="11" Foreground="#64748B" Margin="0,14,0,0" />
                                <TextBlock FontWeight="SemiBold" Margin="0,2,0,0">
                                    <Run Text="{Binding SelectedTablePendingOrder.BillNumber, Mode=OneWay, TargetNullValue='—'}" />
                                    <Run Text="  /  " />
                                    <Run Text="{Binding SelectedTablePendingOrder.KitchenTicketNumber, Mode=OneWay, TargetNullValue='—'}" />
                                </TextBlock>

                                <TextBlock Text="Customer" FontSize="11" Foreground="#64748B" Margin="0,14,0,0" />
                                <TextBlock Text="{Binding SelectedTablePendingOrder.CustomerName, TargetNullValue='Walk-in'}"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0" />

                                <TextBlock Text="Captain order items" FontSize="11" Foreground="#64748B" Margin="0,14,0,4" />
                                <ItemsControl ItemsSource="{Binding SelectedTablePendingOrder.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="85" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ItemName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Quantity, Mode=OneWay}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" HorizontalAlignment="Right">
                                                    <Run Text="&#x20B9; " />
                                                    <Run Text="{Binding Total, Mode=OneWay, StringFormat={}{0:N2}}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2">
                            <TextBlock HorizontalAlignment="Right" FontSize="20" FontWeight="Bold">
                                <Run Text="&#x20B9; " />
                                <Run Text="{Binding SelectedTablePendingOrder.GrandTotal, Mode=OneWay, StringFormat={}{0:N2}}" />
                            </TextBlock>
                            <Button Content="Print requested bill"
                                    Command="{Binding PrintSelectedTableBillCommand}"
                                    Background="#DC2626"
                                    Foreground="White"
                                    Padding="12,7"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding CanPrintSelectedTableBill, Converter={StaticResource V}}" />
                            <Button Content="Open bill for payment"
                                    Command="{Binding OpenSelectedTableBillCommand}"
                                    Background="#16A34A"
                                    Foreground="White"
                                    Padding="12,7"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding CanOpenSelectedTableBill, Converter={StaticResource V}}" />
                            <TextBlock Text="Select an occupied table to review the captain order. Cashier cannot add or change table items."
                                       Foreground="#64748B"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
