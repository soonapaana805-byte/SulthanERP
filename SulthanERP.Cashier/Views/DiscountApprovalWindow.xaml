<Window x:Class="SulthanERP.Cashier.Views.DiscountApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manager discount approval"
        Width="430"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="MANAGER APPROVAL"
                   FontSize="20"
                   FontWeight="Bold" />
        <TextBlock Grid.Row="1"
                   x:Name="SubTotalText"
                   Foreground="#475569"
                   Margin="0,4,0,14" />

        <TextBlock Grid.Row="2" Text="Discount amount" FontWeight="SemiBold" />
        <TextBox Grid.Row="3"
                 x:Name="DiscountAmountInput"
                 Height="34"
                 Margin="0,4,0,12"
                 VerticalContentAlignment="Center" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Admin username" FontWeight="SemiBold" />
                <TextBox x:Name="ManagerUserNameInput"
                         Height="34"
                         Margin="0,4,0,0"
                         VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Admin password" FontWeight="SemiBold" />
                <PasswordBox x:Name="ManagerPasswordInput"
                             Height="34"
                             Margin="0,4,0,0"
                             VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="5"
                   Text="Reason (mandatory)"
                   FontWeight="SemiBold"
                   Margin="0,12,0,0" />
        <TextBox Grid.Row="6"
                 x:Name="ReasonInput"
                 Height="66"
                 Margin="0,4,0,0"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MaxLength="250" />

        <TextBlock Grid.Row="7"
                   x:Name="ValidationMessage"
                   Foreground="#B91C1C"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    IsCancel="True"
                    MinWidth="90"
                    Padding="12,7"
                    Margin="0,0,8,0" />
            <Button Content="Approve discount"
                    IsDefault="True"
                    MinWidth="140"
                    Padding="12,7"
                    Background="#2563EB"
                    Foreground="White"
                    Click="Approve_Click" />
        </StackPanel>
    </Grid>
</Window>
